# ============================================================
# Reclaim — AI Revenue Recovery Agent (environment template)
# Copy to `.env` and fill in. Never commit the real `.env`.
# ============================================================

# --- LLM backend (OpenAI-compatible client -> local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b-instruct
OLLAMA_TIMEOUT_SECONDS=30
# offline = deterministic rule shim (hermetic tests / demos). online = real Ollama calls.
LLM_MODE=offline

# --- Razorpay ---
# REQUIRED: the webhook signing secret. Generate one: `python -c "import secrets; print(secrets.token_hex(32))"`
RAZORPAY_WEBHOOK_SECRET=
# Test-mode API keys (required ONLY when ACT_MODE=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# stub = log the would-be Razorpay call (safe for demos, no credentials needed).
# live = real test-mode network calls; hard-fails if the keys above are empty.
ACT_MODE=stub

# --- Celery / Redis (Upstash) ---
# NOTE: Upstash serves Redis over TLS, so the scheme MUST be `rediss://`, not `redis://`.
# Put YOUR real Upstash URL in .env (never commit it); this is just the shape.
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@your-database.upstash.io:6379
# Set to 1 for tests / demos: runs celery tasks synchronously, no broker needed.
RECLAIM_CELERY_EAGER=1

# --- Database ---
# PostgreSQL-compatible schema; swap the engine DSN here when migrating.
DATABASE_URL=sqlite:///reclaim.db

# --- Stopping-rule thresholds (code-enforced, override the LLM) ---
ESCALATION_AMOUNT_THRESHOLD=5000
ESCALATION_DAYS_THRESHOLD=7
MAX_RETRIES_PER_CYCLE=3
COOLDOWN_HOURS=24
EMAIL_CAP_PER_7D=1

# --- Concurrency throttle (protects local Ollama during batch runs) ---
MAX_CONCURRENCY=5
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=15